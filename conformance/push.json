              }
            }
          }
        }
      },
      "form": "front.entry",
      "step": "confirm",
      "push": {
        "event": "front_entry_confirm",
        "form": "front.entry",
        "step": "confirm",
        "posting_code": "241116ab"
      },
      "warnings": [
        "unknown form: front.gone",
        "unknown param: front.entry.confirm.gone",
        "unknown step: front.entry.view"
      ]
    },
    {
      "name": "a settings parameter with a reserved prefix is a stale name, not a broken file",
      "settings": {
        "version": 1,
        "forms": {
          "front.entry": {
            "steps": {
              "confirm": {
                "params": {
                  "google_x": true
                }
              }
