    {
      "name": "turned off in the catalog, whatever the settings say",
      "settings": {
        "version": 1,
        "forms": {
          "front.job-search": {
            "enabled": true
          }
        }
      },
      "form": "front.job-search",
      "step": "view",
      "push": null
    },
    {
      "name": "stale names are skipped with warnings; the rest is pushed",
      "settings": {
        "version": 1,
        "forms": {
          "front.gone": {
            "enabled": false
          },
          "front.entry": {
            "steps": {
              "confirm": {
                "params": {
                  "posting_code": true,
                  "gone": true
