          }
        }
      },
      "form": "front.entry",
      "step": "confirm",
      "push": {
        "event": "front_entry_confirm",
        "form": "front.entry",
        "step": "confirm",
        "posting_code": "241116ab"
      },
      "warnings": [
        "unknown param: front.entry.confirm.google_x"
      ]
    },
    {
      "name": "a broken settings file stops every push",
