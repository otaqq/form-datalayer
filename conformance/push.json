      },
      "form": "front.entry",
      "step": "complete",
      "push": {
        "event": "entry_complete",
        "form": "front.entry",
        "step": "complete",
        "posting_code": "241116ab"
      }
    },
    {
      "name": "error has the default name of its own and the parameters of its own",
      "settings": null,
      "form": "front.entry",
      "step": "error",
      "push": {
        "event": "front_entry_error",
        "form": "front.entry",
        "step": "error",
        "posting_code": "241116ab"
      }
    },
    {
      "name": "mode is sent when known",
      "settings": {
        "version": 1,
        "forms": {
          "admin.job-posting": {
            "steps": {
              "complete": {
                "params": {
                  "role": true
                }
              }
