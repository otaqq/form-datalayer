      "form": "front.entry",
      "step": "confirm",
      "push": {
        "event": "front_entry_confirm",
        "form": "front.entry",
        "step": "confirm",
        "posting_code": "241116ab"
      }
    },
    {
      "name": "event name from the settings",
      "settings": {
        "version": 1,
        "forms": {
          "front.entry": {
            "steps": {
              "complete": {
                "event": "entry_complete"
              }
            }
          }
