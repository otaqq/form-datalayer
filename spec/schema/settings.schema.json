{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/otaqq/form-datalayer/main/spec/schema/settings.schema.json",
  "title": "form-datalayer settings",
  "description": "Which forms are measured, their event names and chosen parameters, and the container ids. Kept outside the repository and written from the settings screen. See spec/settings.md.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "containers": {
      "type": "object",
      "description": "Container name → GTM container id, or empty for none (spec/output.md)",
      "propertyNames": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:GTM-[A-Z0-9]+)?$"
      }
    },
    "forms": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/form"
      }
    }
  },
  "$defs": {
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "input, confirm, complete or error; other names (view of v0.2) are stale, not errors"
          },
          "additionalProperties": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "not": {
            "type": "string",
            "pattern": "^(?:google_|ga_|firebase_)"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
