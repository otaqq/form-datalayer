{
  "version": 1,
  "forms": {
    "front.entry": {
      "label": "Job application",
      "params": {
        "posting_code": {"label": "Posting code", "from": "posting.code", "default": true},
        "prefectures": {"label": "Prefectures", "from": "posting.prefecture_ids.*", "lookup": {"table": "prefectures", "key": "id", "column": "name"}, "default": true},
        "desired": {"label": "Desired prefecture", "from": "input.desired_prefecture_id", "lookup": {"table": "prefectures", "key": "id", "column": "name"}}
      }
    },
    "admin.job-posting": {
      "label": "Job posting",
      "params": {
        "role": {"label": "Role", "from": "user.role", "default": true}
      }
    },
    "front.inquiry": {
      "label": "Inquiry",
      "enabled": false,
      "steps": {"input": [{"page": "front.inquiries.create"}]}
    }
  }
}
